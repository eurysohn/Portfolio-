# OpenAI API Configuration
OPENAI_API_KEY=sk-your-api-key-here

# LLM Model Selection
# Options: gpt-4o-mini (cheaper), gpt-4o (more capable), gpt-3.5-turbo
LLM_MODEL=gpt-4o-mini

# LLM Temperature (0.0 = deterministic, 1.0 = creative)
LLM_TEMPERATURE=0.0

# Generator Mode
# Options: rule_based (fast, templates only), llm (AI-powered), hybrid (rules + LLM fallback)
GENERATOR_MODE=hybrid

# Database URL
DB_URL=sqlite:///data/app.db

# Agent Configuration
MAX_ROWS=200
ALLOW_UNION=false
